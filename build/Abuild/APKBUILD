# Alpine-Contributor: Sören Tempel <soeren+alpine@soeren-tempel.net>
# Alpine-Maintainer: Natanael Copa <ncopa@alpinelinux.org>
# Maintianer: Aaron Bassett <abassett@qnx.com>
pkgname=graphviz
pkgver=13.1.2
pkgrel=3
pkgdesc="Graph Visualization Tools"
url="https://www.graphviz.org/"
arch="all"
license="EPL-1.0"
options="!check" # fixme: enable testsuite
_luaver=5.4
depends="font-cantarell cairo expat $pkgname-libs libgd glib pango libwebp zlib-ng libc++"
depends_dev="
    cairo-dev
    expat-dev
    fontconfig-dev
    freetype-dev
    gd-dev
    gmp-dev
    libjpeg-turbo-dev
    libpng-dev
    pango-dev
    python3-dev
    zlib-ng-dev
    "
depends_libs="libexpat zlib-ng"
makedepends="
    $depends_dev
    bison
    flex
    libltdl
    lua$_luaver-dev
    m4
    swig
    tcl
    clang
    libc++-dev
    lua$_luaver-libs
    "
install="$pkgname.pre-deinstall"
triggers="$pkgname.trigger=/usr/lib/graphviz"
subpackages="
    $pkgname-dev
    $pkgname-libs
    $pkgname-doc
    python3-gv:_py3
    lua$_luaver-$pkgname:_lua
    $pkgname-graphs::noarch
    "
source="$pkgname-$pkgver.tar.xz::https://gitlab.com/api/v4/projects/4207231/packages/generic/graphviz-releases/$pkgver/graphviz-$pkgver.tar.xz
        qnx_fix.patch
        fix-dl-iter.patch
"

prepare() {
    default_prepare
    #update_config_sub
}

build() {
    CC="clang" \
    CXX="clang++" \
    LIBPOSTFIX=/ \
    LUA=lua$_luaver \
    lua_suffix=$_luaver \
    CFLAGS="$CFLAGS -O2 -Qunused-arguments" \
    CXXFLAGS="$CXXFLAGS -O2 -Qunused-arguments" \
    ./configure \
        --build=$CBUILD \
        --host=$CHOST \
        --prefix=/usr \
        --sysconfdir=/etc \
        --disable-python \
        --disable-silent-rules \
        --disable-static \
        --disable-dependency-tracking \
        --disable-ltdl-install \
        --enable-ltdl \
        --enable-sharp=no \
        --enable-go=no \
        --enable-guile=no \
        --enable-java=no \
        --enable-lua=yes \
        --enable-ocaml=no \
        --enable-perl=no \
        --enable-php=no \
        --enable-python3 \
        --enable-r=no \
        --enable-ruby=no \
        --enable-tcl=no \
        --without-included-ltdl \
        --with-gdk-pixbuf=yes \
        --with-ipsepcola=yes \
        --with-jpeg \
        --with-libgd=yes \
        --with-pangocairo=yes \
        --with-rsvg=yes \
        --with-x

    make
}

package() {
    # Install has race conditions...
    make DESTDIR="$pkgdir" \
        pkgconfigdir=/usr/lib/pkgconfig \
        install
}

_py3() {
    pkgdesc="Python3 extension for graphviz"
    depends="python3"

    amove usr/lib/graphviz/python3* \
        usr/lib/python3*
}

_lua() {
    pkgdesc="Lua$_luaver extension for graphviz"
    provides="lua-$pkgname=$pkgver-r$pkgrel"  # for backward compatibility
    replaces="lua-$pkgname"  # for backward compatibility
    depends="$pkgname-libs lua$_luaver-libs"

    mkdir -p "$subpkgdir"/usr/lib/lua
    mv "$pkgdir"/usr/lib/lua "$subpkgdir"/usr/lib/lua/$_luaver

    amove usr/lib/graphviz/lua
}

graphs() {
    pkgdesc="Demo graphs for graphviz"

    amove usr/share/graphviz/graphs
}


